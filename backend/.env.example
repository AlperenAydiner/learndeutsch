# Bu dosyayi .env olarak kopyalayip kendi degerlerinle doldur.
# .env dosyasi ASLA repoya girmez (.gitignore engeller).

# --- Supabase veritabani baglantisi ---
# Supabase panel > Project Settings > Database > Connection string (URI)
DB_URL=jdbc:postgresql://aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DB_USERNAME=postgres.xxxxxxxxxxxxxxxxxxxx
DB_PASSWORD=

# --- Supabase Auth (JWT dogrulama) ---
# Supabase panel > Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# JWKS ucu: ${SUPABASE_URL}/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URI=https://xxxxxxxxxxxxxxxxxxxx.supabase.co/auth/v1/.well-known/jwks.json

# --- Frontend (CORS) ---
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
